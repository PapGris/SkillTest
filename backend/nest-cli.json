{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "watchOptions": {
      "watchFile": "fixedPollingInterval",
      "watchDirectory": "fixedPollingInterval",
      "fallbackPolling": "fixedPollingInterval",
      "interval": 1000
    }
  }
}
